# Public Facebook App ID from Meta for Developers > App settings > Basic
NEXT_PUBLIC_FACEBOOK_APP_ID=123456789012345

# Keep this URL stable because Facebook ties comments to the exact page URL
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Update only when Meta deprecates the current Graph API version
NEXT_PUBLIC_FACEBOOK_GRAPH_VERSION=v26.0
