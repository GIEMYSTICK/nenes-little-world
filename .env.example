# Local/manual fallback. Vercel production uses VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Google Analytics 4 (public Measurement ID, for example G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Supabase (public values are safe in the browser; RLS protects the data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (never expose the secret or webhook secret)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Gmail SMTP credentials. Never prefix these variables with NEXT_PUBLIC_.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=jiminun1@gmail.com
SMTP_APP_PASSWORD=your-16-character-app-password
CONTACT_TO_EMAIL=jiminun1@gmail.com
